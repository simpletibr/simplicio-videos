{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simplicio.openverse-api/v1",
  "description": "Fatos da API do Openverse usados pelo comando openverse, cada um com fonte, data de leitura e confiança.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "base",
    "read_on",
    "fatos"
  ],
  "properties": {
    "schema": {
      "const": "simplicio.openverse-api/v1"
    },
    "base": {
      "const": "https://api.openverse.org/v1"
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "fatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campo",
          "valor",
          "source_url",
          "read_on",
          "confidence",
          "nota"
        ],
        "properties": {
          "campo": {
            "type": "string"
          },
          "valor": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "read_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "enum": [
              "official",
              "observed",
              "source-code",
              "UNVERIFIED"
            ]
          },
          "nota": {
            "type": "string"
          }
        }
      }
    }
  }
}
