{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simplicio.openverse-licenses/v1",
  "description": "Licenças Creative Commons que o comando openverse conhece: o que permitem e qual aviso dar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_url",
    "read_on",
    "nota",
    "licencas"
  ],
  "properties": {
    "schema": {
      "const": "simplicio.openverse-licenses/v1"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nota": {
      "type": "string"
    },
    "licencas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nome",
          "versao_padrao",
          "padrao",
          "atribuicao_obrigatoria",
          "uso_comercial",
          "permite_modificacao",
          "compartilha_igual",
          "aviso",
          "url_modelo",
          "resumo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "versao_padrao": {
            "type": [
              "string",
              "null"
            ]
          },
          "padrao": {
            "type": "boolean"
          },
          "atribuicao_obrigatoria": {
            "type": "boolean"
          },
          "uso_comercial": {
            "type": "boolean"
          },
          "permite_modificacao": {
            "type": "boolean"
          },
          "compartilha_igual": {
            "type": "boolean"
          },
          "aviso": {
            "type": [
              "string",
              "null"
            ]
          },
          "url_modelo": {
            "type": "string",
            "pattern": "^https://"
          },
          "resumo": {
            "type": "string"
          }
        }
      }
    }
  }
}
