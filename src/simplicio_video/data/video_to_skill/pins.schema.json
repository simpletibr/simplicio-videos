{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simplicio.video-to-skill-pins/v1",
  "description": "Release pinada do vts-extract (video-to-skill, MIT): um asset por plataforma com o sha256 do arquivo e do executável que ele traz, e o sha256 dos arquivos de texto do commit fixado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "author",
    "license",
    "version",
    "tag",
    "commit",
    "release_url_base",
    "read_on",
    "assets",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "simplicio.video-to-skill-pins/v1"
    },
    "source": {
      "const": "https://github.com/brenoepics/video-to-skill"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "MIT"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_url_base": {
      "type": "string",
      "pattern": "^https://github\\.com/brenoepics/video-to-skill/releases/download/v\\d+\\.\\d+\\.\\d+/$"
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "system",
          "machines",
          "file",
          "format",
          "member",
          "sha256",
          "size",
          "member_sha256",
          "member_size"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "pattern": "^(linux|macos|windows)-(x86_64|arm64)$"
          },
          "system": {
            "enum": [
              "Linux",
              "Darwin",
              "Windows"
            ]
          },
          "machines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "file": {
            "type": "string",
            "pattern": "^vts-extract-[a-z0-9_]+-[a-z0-9_]+\\.(tar\\.gz|zip)$"
          },
          "format": {
            "enum": [
              "tar.gz",
              "zip"
            ]
          },
          "member": {
            "enum": [
              "vts-extract",
              "vts-extract.exe"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "member_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "member_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
