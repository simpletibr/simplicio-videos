{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simplicio.busca-tinyfish/v1",
  "description": "Fatos do CLI tinyfish usados pelo comando busca, cada um com fonte, data de leitura e confiança.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pacote",
    "versao_testada",
    "variavel_ambiente",
    "read_on",
    "fatos"
  ],
  "properties": {
    "schema": {
      "const": "simplicio.busca-tinyfish/v1"
    },
    "pacote": {
      "const": "@tiny-fish/cli"
    },
    "versao_testada": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "variavel_ambiente": {
      "const": "TINYFISH_API_KEY"
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "fatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campo",
          "valor",
          "fonte",
          "read_on",
          "confidence",
          "nota"
        ],
        "properties": {
          "campo": {
            "type": "string"
          },
          "valor": {
            "type": "string"
          },
          "fonte": {
            "type": "string"
          },
          "read_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "enum": [
              "official",
              "observed",
              "UNVERIFIED"
            ]
          },
          "nota": {
            "type": "string"
          }
        }
      }
    }
  }
}
