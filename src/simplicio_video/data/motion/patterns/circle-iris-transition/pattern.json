  "duration_s": 1.5,
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "params": [
    {
      "id": "label_a",
      "type": "string",
      "label": "Texto cena A",
      "default": "Antes",
      "maxLength": 12
    },
    {
      "id": "label_b",
      "type": "string",
      "label": "Texto cena B",
      "default": "Depois",
      "maxLength": 12
    },
    {
      "id": "cx",
      "type": "number",
      "label": "Centro X (px)",
      "default": 540
    },
    {
      "id": "cy",
      "type": "number",
      "label": "Centro Y (px)",
      "default": 900
    },
    {
      "id": "primary",
      "type": "color",
      "label": "Cor primária",
      "default": "#e50914"
    },
    {
      "id": "secondary",
      "type": "color",
      "label": "Cor secundária",
      "default": "#1565ff"
    }
  ],
  "files": {
    "block": "block.html",
    "preview": "preview.png"
  },
  "category": "transição",
  "tags": [
    "íris",
    "match-cut",
    "antes-depois"
  ],
  "use_when": "Antes/depois ou troca de tema com elemento redondo (logo, foto de perfil, prato, relógio).",
  "source": {
    "kind": "video-shotcraft",
