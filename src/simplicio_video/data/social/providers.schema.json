{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simplicio.social-providers/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "default",
    "read_on",
    "rules",
    "providers"
  ],
  "properties": {
    "schema": {
      "const": "simplicio.social-providers/v1"
    },
    "default": {
      "type": "string"
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "default",
          "mcp_url",
          "source_url",
          "read_on",
          "confidence",
          "auth",
          "networks",
          "pricing",
          "known_limits",
          "gaps",
          "unverified",
          "publish_tools",
          "tools",
          "recipe"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "mcp_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "read_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "enum": [
              "official",
              "UNVERIFIED"
            ]
          },
          "auth": {
            "type": "string"
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pricing": {
            "type": "string"
          },
          "known_limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unverified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publish_tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "params",
                "effect",
                "description",
                "confidence"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "params": {
                  "type": "string"
                },
                "effect": {
                  "enum": [
                    "read",
                    "quote",
                    "publish",
                    "other"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "confidence": {
                  "enum": [
                    "official",
                    "UNVERIFIED"
                  ]
                }
              }
            },
            "minItems": 1
          },
          "recipe": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "local",
                    "manual",
                    "call",
                    "show",
                    "consent"
                  ]
                },
                "tool": {
                  "type": "string"
                },
                "effect": {
                  "enum": [
                    "read",
                    "quote",
                    "publish",
                    "other"
                  ]
                },
                "when": {
                  "type": "string"
                },
                "requires": {
                  "const": "consent"
                },
                "args": {
                  "type": "object"
                },
                "args_confidence": {
                  "enum": [
                    "official",
                    "UNVERIFIED"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "blocks": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
