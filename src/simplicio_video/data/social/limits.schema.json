{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "simplicio.social-limits/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "read_on",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "simplicio.social-limits/v1"
    },
    "read_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "about": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network",
          "field",
          "value",
          "source_url",
          "read_on",
          "confidence",
          "note"
        ],
        "properties": {
          "network": {
            "enum": [
              "youtube",
              "tiktok",
              "instagram",
              "facebook",
              "twitter",
              "linkedin",
              "threads",
              "pinterest",
              "bluesky"
            ]
          },
          "field": {
            "enum": [
              "duration_min_s",
              "duration_max_s",
              "aspect_ratios",
              "size_max_mb",
              "caption_max_chars",
              "title_max_chars",
              "hashtags_max"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d+:\\d+$"
                },
                "minItems": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "min_ratio",
                  "max_ratio"
                ],
                "properties": {
                  "min_ratio": {
                    "type": "number"
                  },
                  "max_ratio": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "read_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "enum": [
              "official",
              "UNVERIFIED"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "const": "UNVERIFIED"
                }
              }
            }
          }
        ]
      }
    }
  }
}
