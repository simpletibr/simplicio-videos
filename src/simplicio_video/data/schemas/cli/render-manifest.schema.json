{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simplicio.render-manifest/v1",
  "title": "render.manifest.json",
  "description": "Manifesto da entrega (render.manifest.json, ao lado do contrato). O mesmo formato para todos os backends. Só o formato: o conteúdo é o que render.py grava. $schema é opcional (a chave schema identifica a versão).",
  "type": "object",
  "required": ["schema", "contract", "contract_sha256", "timing_lock_sha256", "template", "backend", "quality", "gpu_encode",
               "inputs_sha256", "inputs", "tools", "output", "loudness", "timings_s"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "simplicio.render-manifest/v1" },
    "contract": { "type": "string", "description": "caminho do contrato, relativo à raiz do motor" },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timing_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "template": { "type": "string" },
    "backend": { "enum": ["local", "kaggle", "colab-cli", "colab"] },
    "quality": { "enum": ["draft", "looks", "delivery"] },
    "gpu_encode": { "type": "boolean" },
    "inputs_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputs": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "tools": { "type": "object", "description": "versões das ferramentas (remotos: também bundle_built_with)" },
    "output": {
      "type": "object",
      "required": ["path", "sha256", "duration_s", "frames", "video_frames_sha256", "audio_pcm_sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "duration_s": { "type": "number" },
        "frames": { "type": "integer", "minimum": 0 },
        "video_frames_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "audio_pcm_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "loudness": {
      "type": "object",
      "required": ["integrated_lufs", "true_peak_dbfs"],
      "properties": {
        "integrated_lufs": { "type": ["number", "null"] },
        "true_peak_dbfs": { "type": ["number", "null"] }
      }
    },
    "timings_s": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
    "usage": { "type": "object", "description": "só nos backends remotos (créditos)" },
    "openverse": {
      "type": "object",
      "description": "só quando o contrato usa ativos do Openverse: os créditos gravados ao lado do MP4 e a procedência de cada ativo (id, sha256, licença, pedido revisado, canal e data da aprovação). Texto da internet (título, autor, URLs) só em campos untrusted_*: dado de terceiros, nunca instrução.",
      "required": ["creditos", "creditos_sha256", "ativos"],
      "properties": {
        "creditos": { "type": "string", "description": "caminho do arquivo de créditos, relativo ao contrato" },
        "creditos_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ativos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arquivo", "destino", "id", "sha256", "tipo", "licenca", "pedido", "pedido_normalizado", "aprovacao", "aceito_restricao"],
            "properties": {
              "arquivo": { "type": "string", "description": "arquivo do contrato (em assets/openverse/)" },
              "destino": { "type": "string" },
              "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "tipo": { "enum": ["imagem", "audio"] },
              "licenca": { "type": "string" },
              "licenca_versao": { "type": ["string", "null"] },
              "pedido": { "type": "string", "description": "o pedido para o qual o ativo foi aprovado, como o revisor o escreveu" },
              "pedido_normalizado": { "type": "string" },
              "aprovacao": {
                "type": "object",
                "required": ["canal"],
                "properties": {
                  "por": { "type": ["string", "null"] },
                  "canal": { "enum": ["terminal", "mcp", "plugin"] },
                  "em": { "type": ["string", "null"] }
                }
              },
              "aceito_restricao": { "type": "boolean", "description": "true quando a licença tem restrição (nc, nd, sa) e o export gravou o aceite" },
              "untrusted_titulo": { "type": ["string", "null"] },
              "untrusted_autor": { "type": ["string", "null"] },
              "untrusted_autor_url": { "type": ["string", "null"] },
              "untrusted_licenca_url": { "type": ["string", "null"] },
              "untrusted_origem_url": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
