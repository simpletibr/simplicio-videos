{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simplicio.video-spec/v1",
  "title": "PROPOSAL — simplicio-videos per-video spec",
  "type": "object",
  "required": [
    "schema",
    "id",
    "client",
    "engine",
    "format"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simplicio.video-spec/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "client": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "brief": {
      "type": "string",
      "description": "relative path to the client's brief.md (source of truth for copy)"
    },
    "engine": {
      "enum": [
        "hyperframes",
        "simplicio-motion"
      ]
    },
    "format": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 120
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "channel": {
          "type": "string",
          "description": "e.g. instagram-reels, tiktok, youtube-shorts"
        }
      }
    },
    "entry": {
      "type": "string",
      "description": "engine=hyperframes: composition file (index.html)"
    },
    "variables_file": {
      "type": "string",
      "description": "engine=hyperframes: flat JSON object of variable values passed to --variables-file (generated by build from spec_file)"
    },
    "storyboard_file": {
      "type": "string",
      "description": "engine=simplicio-motion: simplicio.storyboard/v1 IR"
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "description": "authoring model; currently only claude-opus-5-5"
        },
        "prompt_file": {
          "type": "string"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    },
    "slots": {
      "type": "array",
      "description": "assets the client must provide",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio",
              "logo",
              "text"
            ]
          },
          "status": {
            "enum": [
              "placeholder",
              "draft-from-site",
              "client-provided",
              "approved"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "string"
    },
    "sources": {
      "type": "string",
      "description": "relative path to the client's info-gathering folder (coleta/)"
    },
    "spec_file": {
      "type": "string",
      "description": "engine=hyperframes: authoring spec with variables + audio cues + clip slots (spec.json)"
    },
    "build": {
      "type": "string",
      "description": "deterministic pre-render command (no LLM), e.g. node scripts/build.mjs"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "procedural",
            "file",
            "none"
          ]
        },
        "build": {
          "type": "string"
        },
        "spec_key": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "target_lufs": {
          "type": "number",
          "minimum": -30,
          "maximum": -6
        },
        "true_peak_db": {
          "type": "number",
          "maximum": 0
        },
        "license": {
          "type": "string"
        }
      }
    },
    "clips": {
      "type": "object",
      "description": "optional full-bleed video plates (e.g. AI-generated clips) with fallback to the scene design",
      "additionalProperties": false,
      "properties": {
        "spec_key": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "voice": {
      "type": "object",
      "description": "voice-over: lines live in spec_file[spec_key]; audio rendered/cached by the voice step",
      "additionalProperties": false,
      "properties": {
        "spec_key": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "chatterbox",
            "kokoro",
            "elevenlabs",
            "xai",
            "file",
            "none"
          ]
        },
        "model": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "lang": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "render": {
          "type": "string"
        },
        "cache": {
          "type": "string"
        }
      }
    }
  }
}
