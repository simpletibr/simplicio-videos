  "voice": {
    "_doc": "Voice-over (narração). 'text' = exact copy (facts from ../coleta/brief.md); 'say' = optional pronunciation respelling sent to the TTS. 't' = start (s) on the 120 BPM grid; 'max_s' = slot length. NO time-stretch: a take longer than its slot fails. npm run voice renders/caches lines in assets/audio/vo/; npm run build mixes them.",
    "enabled": true,
    "provider": "chatterbox",
    "providers": {
      "chatterbox": {
        "model": "Chatterbox Multilingual V3 (ResembleAI/chatterbox, MIT)",
        "t3_model": "v3",
        "language": "pt",
        "exaggeration": 0.55,
        "cfg_weight": 0.5,
        "temperature": 0.7,
        "seeds": [
          7,
          11,
          23
        ],
        "reference": {
          "engine": "kokoro-v1.0",
          "voice": "pm_alex",
          "text": "Olá! Hoje eu vou te mostrar como a gente conserta consoles e controles, com diagnóstico cuidadoso e atendimento rápido. Tudo explicado, sem surpresa."
        }
      },
      "kokoro": {
        "model": "kokoro-v1.0 (hexgrad/Kokoro-82M, ONNX via kokoro-onnx)",
        "voice": "pf_dora",
        "lang": "pt-br",
        "speed": 1.0
      },
      "elevenlabs": {
        "model": "eleven_multilingual_v2",
        "voice_id": "<ELEVENLABS_VOICE_ID>",
        "stability": 0.4,
        "similarity_boost": 0.8,
        "style": 0.35,
        "env": "ELEVENLABS_API_KEY"
      },
      "xai": {
        "model": "xAI Text to Speech (api.x.ai/v1/tts)",
        "voice_id": "rex",
        "language": "pt-BR",
        "env": "XAI_API_KEY"
      },
      "file": {
        "_doc": "Externally generated narration (e.g. Gemini TTS / Google AI Studio). One file per voice.lines entry, in order: line-01.wav = vo1 ... line-09.wav = vo9 (or vo1.wav...). Any sample rate/channels; voice.py trims silence, applies voice.processing, converts to 48 kHz mono and enforces max_s (no time-stretch). Use: VOICE_PROVIDER=file npm run voice (or set provider to \"file\").",
        "dir": "assets/audio/vo/external",
        "patterns": [
          "line-{n:02d}.wav",
          "{id}.wav",
          "line-{n:02d}.mp3",
          "line-{n:02d}.m4a"
        ],
        "source": "Gemini TTS (Google AI Studio) — record model/voice/date in assets/audio/LICENSES.md"
      }
    },
