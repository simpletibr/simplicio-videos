{
  "schema": "simplicio.video-spec/v1",
  "id": "wjr-video-01",
  "client": "wjr-informatica-games",
  "brief": "../coleta/brief.md",
  "sources": "../coleta/",
  "engine": "hyperframes",
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration_s": 20,
    "channel": "instagram-reels"
  },
  "entry": "index.html",
  "spec_file": "spec.json",
  "variables_file": "build/variables.json",
  "build": "node scripts/build.mjs",
  "audio": {
    "mode": "procedural",
    "build": "scripts/build.mjs",
    "spec_key": "audio",
    "output": "assets/audio/build/mix.wav",
    "target_lufs": -14,
    "true_peak_db": -1.5,
    "license": "assets/audio/LICENSES.md"
  },
  "voice": {
    "spec_key": "voice",
    "provider": "file",
    "model": "gemini-3.8-flash-tts (Google AI Studio)",
    "voice": "Puck",
    "lang": "pt-BR",
    "license": "Gemini API Additional Terms (Google does not claim ownership of generated content)",
    "render": "npm run voice",
    "cache": "assets/audio/vo/manifest.json"
  },
  "clips": {
    "spec_key": "clips",
    "dir": "assets/imagine",
    "count": 5
  },
  "storyboard_file": "storyboard.simplicio.json",
  "authoring": {
    "model": "claude-opus-5-5",
    "prompt_file": "PROMPT.md",
    "effort": "medium"
  },
  "slots": [
    {
      "id": "logo",
      "kind": "logo",
      "status": "draft-from-site",
      "notes": "public PNG from the site; ask for SVG/high-res + usage permission"
    },
    {
      "id": "photo_hero",
      "kind": "image",
      "status": "draft-from-site",
      "notes": "site image looks illustrative; replace with a real store/console photo"
    },
    {
      "id": "photo_bench",
      "kind": "image",
      "status": "draft-from-site",
      "notes": "replace with a real workbench photo or vertical video"
    }
  ],
  "output": "out/video-01.mp4"
}
