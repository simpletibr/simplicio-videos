# Copy to .env (never commit .env). Placeholders only.

# Cloudflare control plane
CF_ACCOUNT_ID=
CF_QUEUE_ID=
CF_API_TOKEN=            # permissions: Account > Queues > Edit
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=h3-swap

# API <-> worker shared secrets
API_BASE_URL=https://api.example.com
WORKER_SECRET=
ADMIN_SECRET=

# Vast.ai (used by the autoscaler Worker only, never by the GPU box)
VAST_API_KEY=
VAST_IMAGE=ghcr.io/your-org/h3-swap-worker:latest
MAX_WORKERS=2
JOBS_PER_WORKER=4
IDLE_DESTROY_S=900
HEARTBEAT_LOST_S=1200
BOOT_GRACE_S=3600
MAX_DPH=1.0

# Pricing
PRICE_CENTS_PER_SECOND=16
