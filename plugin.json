{
  "schema": "simplicio.plugin/v1",
  "name": "videos",
  "version": "0.5.0",
  "description": "simplicio-videos: Simplicio Runtime video plugin. Entry point = the `simplicio-video` CLI (Python, pyproject.toml): the LLM writes a simplicio.video-contract/v1 YAML (schema/contract.schema.json) and the CLI validates it, renders/caches the voice (file/local/gemini; elevenlabs/xai stubs) into timing.lock.json and renders deterministically (template composition + motion blocks -> HyperFrames frames -> ffmpeg master -14 LUFS, render.manifest.json with hashes), locally or as a Colab GPU bundle (colab/render.ipynb). Skill for LLMs: skills/simplicio-video/SKILL.md. See docs/decisoes/ADR-0001-visao-plugin.md and ADR-0002-cli-contrato-colab-creditos.md. The 'videos' op command below is the older pipeline proposal (intake/brief/edit ops still run through repo scripts).",
  "binary": "simplicio-video",
  "protocol": 1,
  "commands": [
    {
      "verb": "video.init",
      "description": "Write a contract skeleton for <cliente> <campanha> from a sector template (TODOs to fill with coleta facts).",
      "argv": [
        "simplicio-video",
        "init",
        "{cliente}",
        "{campanha}",
        "--template",
        "{template}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cliente",
          "campanha",
          "template"
        ],
        "properties": {
          "cliente": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,64}$"
          },
          "campanha": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Za-z0-9]*(_[A-Za-z0-9]+)*$"
          },
          "template": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "ano": {
            "type": "integer"
          },
          "out": {
            "type": "string"
          }
        }
      }
    },
    {
      "verb": "video.validate",
      "description": "Validate a contract: JSON Schema, assets exist, scene durations sum, every line fits its scene without speed-up.",
      "argv": [
        "simplicio-video",
        "validate",
        "{contrato}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contrato"
        ],
        "properties": {
          "contrato": {
            "type": "string",
            "description": "simplicio.video-contract/v1 YAML (schema/contract.schema.json)"
          },
          "need_lock": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "verb": "video.voice",
      "description": "Render/cache narration lines (file|local|gemini; elevenlabs/xai stubs) and write timing.lock.json with real durations.",
      "argv": [
        "simplicio-video",
        "voice",
        "{contrato}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contrato"
        ],
        "properties": {
          "contrato": {
            "type": "string",
            "description": "simplicio.video-contract/v1 YAML (schema/contract.schema.json)"
          },
          "provider": {
            "enum": [
              "file",
              "local",
              "gemini",
              "elevenlabs",
              "xai"
            ]
          },
          "force": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "verb": "video.render",
      "description": "Compile contract -> HyperFrames composition -> frames -> ffmpeg master. Backends: local (hash reference), kaggle and colab-cli (remote, no browser; same bundle + render_bundle.sh), colab (bundle zip for colab/render.ipynb). Writes render.manifest.json (+ usage for remote). See docs/decisoes/ADR-0003-fluxo-100-script.md.",
      "argv": [
        "simplicio-video",
        "render",
        "{contrato}",
        "--backend",
        "{backend}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contrato"
        ],
        "properties": {
          "contrato": {
            "type": "string",
            "description": "simplicio.video-contract/v1 YAML (schema/contract.schema.json)"
          },
          "backend": {
            "enum": [
              "local",
              "kaggle",
              "colab-cli",
              "colab"
            ],
            "default": "local"
          },
          "out": {
            "type": "string"
          },
          "quality": {
            "enum": [
              "draft",
              "looks",
              "delivery"
            ]
          },
          "account_id": {
            "type": "string",
            "description": "FUTURE (ADR-0002): credit ledger account; ignored today"
          },
          "accelerator": {
            "type": "string",
            "description": "kaggle: NvidiaTeslaT4 (default) | NvidiaL4 | none; colab-cli: T4 (default) | L4 | A100 | none"
          },
          "gpu_encode": {
            "enum": [
              "auto",
              "1",
              "0"
            ],
            "default": "auto",
            "description": "remote NVENC encode; 0 = libx264 (needed to compare frames with local)"
          }
        }
      }
    },
    {
      "verb": "video.publish",
      "description": "Upload saida.arquivo to Google Drive (rclone remote, default gdrive) at drive.caminho/drive.arquivo; never overwrites, idempotent, link from the file ID; records it in clients/<slug>/README.md. Only with an explicit request from the user; otherwise dry_run.",
      "argv": [
        "simplicio-video",
        "publish",
        "{contrato}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contrato"
        ],
        "properties": {
          "contrato": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "remote": {
            "type": "string",
            "default": "gdrive"
          },
          "dry_run": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    {
      "verb": "video.run",
      "description": "validate -> voice -> validate --need-lock -> render -> publish (dry-run unless publish=true).",
      "argv": [
        "simplicio-video",
        "run",
        "{contrato}",
        "--provider",
        "{provider}",
        "--backend",
        "{backend}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contrato"
        ],
        "properties": {
          "contrato": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "file",
              "local",
              "gemini"
            ]
          },
          "backend": {
            "enum": [
              "local",
              "kaggle",
              "colab-cli",
              "colab"
            ],
            "default": "local"
          },
          "quality": {
            "enum": [
              "draft",
              "looks",
              "delivery"
            ]
          },
          "publish": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    {
      "verb": "video.list",
      "description": "List templates, motion patterns or voice providers.",
      "argv": [
        "simplicio-video",
        "list",
        "{what}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what"
        ],
        "properties": {
          "what": {
            "enum": [
              "templates",
              "motion",
              "voices",
              "angles"
            ]
          }
        }
      }
    },
    {
      "verb": "video.clone",
      "description": "Clone viral videos using Hypit AI (https://github.com/hypit-ai/hypit). Invokes hypit CLI to generate video workflows from reference videos.",
      "argv": [
        "simplicio-video",
        "clone",
        "{args}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "string",
            "description": "Arguments passed to hypit CLI"
          }
        }
      }
    },
    {
      "verb": "video.montage",
      "description": "Agentic video production using OpenMontage (https://github.com/calesthio/OpenMontage). Invokes OpenMontage pipelines, backlot board, and tools.",
      "argv": [
        "simplicio-video",
        "montage",
        "{args}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "string",
            "description": "Arguments passed to OpenMontage"
          }
        }
      }
    },
    {
      "verb": "videos",
      "description": "Run the simplicio-videos pipeline steps (proposal): intake, brief, template, compose, voice, edit, check, render, batch; plus catalog lookups for motion patterns, templates and voice providers.",
      "mcp_tool": "plugin_videos",
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "schema",
              "intake",
              "brief",
              "template",
              "patterns",
              "voices",
              "new",
              "compose",
              "voice",
              "edit",
              "handoff",
              "check",
              "render",
              "batch"
            ],
            "description": "intake: questionnaire state/validation (intake/intake.schema.json); brief: intake -> brief + spec; template: pick/list sector templates; patterns: list motion library; voices: list providers; new: scaffold video from template; compose: mount motion blocks from spec; voice: generate/cached TTS; edit (OPTIONAL, only when the user asks for editing help: cut to N seconds, reorder, trim footage, captions, cut review): video-use via tools/video-use (pinned), agent writes edl.json after the user confirms the plan, execution is deterministic; handoff: prompt for Opus 5.5 authoring; check/render/batch: deterministic build."
          },
          "client": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "site": {
            "type": "string",
            "description": "public site URL for intake auto-extraction (op=intake)"
          },
          "instagram": {
            "type": "string",
            "description": "public Instagram handle/URL for intake auto-extraction (op=intake)"
          },
          "intake": {
            "type": "string",
            "description": "path to a simplicio.intake/v1 file"
          },
          "template": {
            "type": "string",
            "description": "sector template id (templates/<id>) or path"
          },
          "spec": {
            "type": "string",
            "description": "path to a simplicio.video-spec/v1 file (video.json)"
          },
          "provider": {
            "type": "string",
            "enum": [
              "file",
              "gemini",
              "elevenlabs",
              "xai",
              "chatterbox",
              "kokoro"
            ],
            "description": "voice provider override (op=voice)"
          },
          "force": {
            "type": "boolean",
            "description": "regenerate voice ignoring the cache (op=voice)"
          },
          "edl": {
            "type": "string",
            "description": "video-use EDL json (op=edit); see tools/video-use/README.md"
          },
          "rows": {
            "type": "string",
            "description": "JSON rows file for op=batch"
          },
          "quality": {
            "type": "string",
            "enum": [
              "draft",
              "looks",
              "delivery"
            ]
          },
          "out": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "input video to edit (op=edit): rendered MP4 or client footage"
          },
          "target_s": {
            "type": "number",
            "description": "target duration in seconds for a cutdown (op=edit)"
          }
        }
      },
      "examples": [
        "videos intake --client acme --site https://acme.com.br --instagram @acme",
        "videos template --intake clients/acme/coleta/intake.json",
        "videos patterns",
        "videos voices",
        "videos new --client wjr-informatica-games --template assistencia-tecnica-games --out clients/wjr-informatica-games/video-02",
        "videos voice --spec clients/wjr-informatica-games/video-01/video.json --provider gemini",
        "videos edit --source clients/wjr-informatica-games/video-01/out/video-01.mp4 --target_s 11.5 --edl clients/wjr-informatica-games/video-02-videouse/edit/edl.json",
        "videos check --spec clients/wjr-informatica-games/video-01/video.json",
        "videos render --spec clients/wjr-informatica-games/video-01/video.json --quality delivery",
        "videos batch --spec clients/wjr-informatica-games/video-01/video.json --rows rows.json"
      ]
    },
    {
      "verb": "video.opencut",
      "description": "OpenCut open-source editor (https://github.com/OpenCut-app/OpenCut): clone, dev, where.",
      "argv": [
        "simplicio-video",
        "opencut",
        "{args}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "string",
            "description": "clone [dir] | dev | where"
          }
        }
      }
    },
    {
      "verb": "video.formats",
      "description": "Library of 50 ad formats from the Drive swipe file: list, show <id>, prompt <id> --copia <arquivo|->.",
      "argv": [
        "simplicio-video",
        "formats",
        "{args}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "string",
            "description": "list [--objetivo clique|lead|venda|engajamento] | show <id> | prompt <id> --copia <arquivo|->"
          }
        }
      }
    },
    {
      "verb": "video.swap",
      "description": "Character swap cost estimate (read-only, no network): provider, video and avatar image in, price out. Paid runs exist only in the terminal: simplicio-video swap run --autorizo --yes.",
      "argv": [
        "simplicio-video",
        "swap",
        "estimate",
        "--provider",
        "{provider}",
        "--video",
        "{video}",
        "--ref",
        "{ref}",
        "--resolution",
        "{resolution}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "video",
          "ref"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "description": "adapter name (see video.swap.providers)"
          },
          "video": {
            "type": "string",
            "description": "input video file"
          },
          "ref": {
            "type": "string",
            "description": "avatar image file"
          },
          "resolution": {
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p"
          }
        }
      }
    },
    {
      "verb": "video.swap.providers",
      "description": "List character swap providers, capabilities, prices (USD and BRL) and confidence. Read-only.",
      "argv": [
        "simplicio-video",
        "swap",
        "providers",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "verb": "video.jobs.list",
      "description": "List background tasks (newest first). A task whose runner died is reported as lost. Read-only.",
      "argv": [
        "simplicio-video",
        "jobs",
        "list",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "verb": "video.jobs.status",
      "description": "State of one background task: running, done, failed, cancelled or lost.",
      "argv": [
        "simplicio-video",
        "jobs",
        "status",
        "{id}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$",
            "description": "id da tarefa (veja video.jobs.list)"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "verb": "video.jobs.result",
      "description": "Result of a finished background task (exit 2 while it still runs).",
      "argv": [
        "simplicio-video",
        "jobs",
        "result",
        "{id}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$",
            "description": "id da tarefa (veja video.jobs.list)"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "verb": "video.jobs.cancel",
      "description": "Cancel a background task (SIGINT to its process group, SIGKILL after the grace period).",
      "argv": [
        "simplicio-video",
        "jobs",
        "cancel",
        "{id}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$",
            "description": "id da tarefa (veja video.jobs.list)"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "verb": "video.jobs.submit-voice",
      "description": "Run voice in the background with a LOCAL provider only (file, local, voxcpm, openvoice): it spends nothing. swap-run and network voice are submitted in the terminal with --yes, never here.",
      "argv": [
        "simplicio-video",
        "jobs",
        "submit",
        "voice",
        "{contrato}",
        "--provider",
        "{provider}",
        "--json"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contrato": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "file",
              "local",
              "voxcpm",
              "openvoice"
            ]
          }
        },
        "required": [
          "contrato",
          "provider"
        ]
      }
    },
    {
      "verb": "video.toonflow",
      "description": "Toonflow open-source AI studio for short dramas and videos (https://github.com/HBAI-Ltd/Toonflow-app): clone into the default folder, where; serve runs in the terminal with --lan.",
      "argv": [
        "simplicio-video",
        "toonflow",
        "{args}"
      ],
      "args_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "args": {
            "type": "string",
            "description": "clone | where (serve --lan: só no terminal)"
          }
        }
      }
    },
    {
      "verb": "video.moneyprinter",
      "description": "MoneyPrinterTurbo topic-to-short-video generator (https://github.com/harry0703/MoneyPrinterTurbo): clone into the default folder and where only; setup and serve run in the terminal.",
      "argv": [
