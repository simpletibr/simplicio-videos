{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/schemas/plugin.manifest.schema.json",
  "title": "Manifesto de plugin do simplicio-video",
  "description": "Conteúdo de src/simplicio_factory/plugins/<id>/plugin.json. Lido por simplicio_video.registry (#32).",
  "type": "object",
  "required": ["id", "kind", "version", "commands"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Identificador do plugin. Tem de ser igual ao nome da pasta."
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Tipo do plugin, por exemplo stage ou studio."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
      "description": "Versão semântica X.Y.Z."
    },
    "commands": {
      "type": "array",
      "description": "Comandos que o plugin acrescenta à CLI.",
      "items": {
        "type": "object",
        "required": ["name", "handler", "help", "example"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Nome do subcomando na CLI."
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$",
            "description": "Função de despacho no formato modulo:funcao. Recebe a lista de argumentos e devolve o código de saída."
          },
          "help": {
            "type": "string",
            "minLength": 1,
            "description": "Texto curto do --help."
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "description": "Exemplo de uso, mostrado no --help."
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "description": "Nomes dos estágios que o plugin registra (opcional).",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
