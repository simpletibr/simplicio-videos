node_modules/
out/
renders/
snapshots/
.frames/
*.partial
.DS_Store
.env
# client assets stay local until the client approves usage
clients/*/*/assets/client/
.hyperframes/
build/
assets/audio/build/

# python (simplicio-video CLI)
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# venda ativa (simplicio-video prospect): prévias, coletas e relatórios ficam fora do git; só o CSV de exemplo entra
prospects/*
!prospects/exemplo-dia-criancas.csv

# estado local do simplicio-loop/runtime
.simplicio/
# estado local do JsonStore da fábrica (#33): SIMPLICIO_FACTORY_HOME, padrão .simplicio-factory/
.simplicio-factory/
.orchestrator/

# client facts never enter the repo (briefs, sources, contacts, saved sites)
clients/*/coleta/
# recibo de posse do `simplicio-video install` (e a pasta do projeto onde ele roda)
.simplicio-video/
# as skills que `simplicio-video install` copia para a raiz deste repositório (a fonte é src/simplicio_video/data/skills/)
.claude/skills/simplicio-video/
.claude/skills/simplicio-video-social/
