{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simpletibr/simplicio-videos/ugc/pack.schema.json",
  "title": "simplicio.ugc-pack/v1",
  "description": "Pack of synthetic UGC characters. Each character fills the fixed Seedance skeleton (src/simplicio_video/ugc.py). Example lines (fala) are format examples, not facts about any client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fonte", "personagens"],
  "properties": {
    "schema": { "const": "simplicio.ugc-pack/v1" },
    "fonte": {
      "type": "object", "additionalProperties": false, "required": ["pack", "autor", "pack_url", "artigo_url", "coletado_em"],
      "properties": {
        "pack": { "type": "string" },
        "autor": { "type": "string" },
        "pack_url": { "type": "string", "format": "uri" },
        "artigo_url": { "type": "string", "format": "uri" },
        "coletado_em": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "personagens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "nome", "genero", "local", "entrega", "fala", "reacao"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
          "nome": { "type": "string", "minLength": 1 },
          "genero": { "enum": ["m", "f"], "description": "selects he/his or she/her in the skeleton" },
          "local": { "type": "string", "minLength": 1, "description": "where they film + light, no trailing period" },
          "entrega": { "type": "string", "pattern": "^[a-z]+$", "description": "ONE delivery word (a pile of adjectives leaves the face flat)" },
          "fala": { "type": "string", "minLength": 1, "not": { "pattern": "\"" }, "description": "example line, 22-28 words for 7 s" },
          "reacao": { "type": "string", "minLength": 1, "description": "what happens at second 5, up to and including the look back at camera, no trailing period" }
        }
      }
    }
  }
}
