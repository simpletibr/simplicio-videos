{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplicio.dev/schemas/simplicio.intake/v1",
  "title": "simplicio.intake/v1",
  "description": "Result of the video intake (questionnaire + auto-extraction from site/Instagram). Every client fact carries its provenance; only facts with confirmado=true (or fonte site/instagram with a dated ref) may reach the video copy.",
  "type": "object",
  "required": ["schema", "modo", "coletado_em", "empresa", "pedido"],
  "$defs": {
    "fonte": { "enum": ["site", "instagram", "usuario", "cliente", "inferido"], "description": "inferido = guessed by the agent (tone, niche); must be confirmed before use" },
    "fato": {
      "type": "object",
      "required": ["valor", "fonte"],
      "properties": {
        "valor": {},
        "fonte": { "$ref": "#/$defs/fonte" },
        "ref": { "type": "string", "description": "URL, CSS file, post, or 'mensagem de <quem> em DD/MM/AAAA'" },
        "data": { "type": "string", "format": "date" },
        "confirmado": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "lista_fatos": { "type": "array", "items": { "$ref": "#/$defs/fato" } }
  },
  "properties": {
    "schema": { "const": "simplicio.intake/v1" },
    "modo": { "enum": ["auto", "completo"], "description": "auto = site and/or Instagram given (extract, then ask only what is missing); completo = full questionnaire" },
    "coletado_em": { "type": "string", "format": "date-time" },
    "fontes": {
      "type": "object",
      "properties": {
        "site": { "type": ["string", "null"], "format": "uri" },
        "instagram": { "type": ["string", "null"], "description": "@handle or profile URL (public data only)" },
        "outros": { "type": "array", "items": { "type": "string" } }
      }
    },
    "empresa": {
      "type": "object",
      "required": ["nome"],
      "properties": {
        "nome": { "$ref": "#/$defs/fato" },
        "nicho": { "$ref": "#/$defs/fato" },
        "setor_template": { "type": "string", "description": "templates/<id> chosen from the niche (see templates/README.md)" },
        "descricao": { "$ref": "#/$defs/fato" },
        "cidade": { "$ref": "#/$defs/fato" },
        "servicos": { "$ref": "#/$defs/lista_fatos" },
        "ofertas": { "$ref": "#/$defs/lista_fatos", "description": "promotions/prices — only if confirmed" },
        "diferenciais": { "$ref": "#/$defs/lista_fatos" },
        "frases_proprias": { "$ref": "#/$defs/lista_fatos", "description": "the client's own slogans/phrases (reusable copy)" },
        "contatos": {
          "type": "object",
          "properties": {
            "whatsapp": { "$ref": "#/$defs/fato" }, "telefone": { "$ref": "#/$defs/fato" }, "email": { "$ref": "#/$defs/fato" },
            "endereco": { "$ref": "#/$defs/fato" }, "instagram": { "$ref": "#/$defs/fato" }, "site": { "$ref": "#/$defs/fato" }, "horario": { "$ref": "#/$defs/fato" }
          }
        }
      }
    },
    "marca": {
      "type": "object",
      "properties": {
        "logo": { "$ref": "#/$defs/fato", "description": "valor = path/URL of the logo file" },
        "cores": { "$ref": "#/$defs/fato", "description": "valor = {primary, secondary, background, foreground}" },
        "fontes": { "$ref": "#/$defs/fato" },
        "tom": { "$ref": "#/$defs/fato", "description": "e.g. 'direto, informal-confiante, vocabulário gamer'" },
        "uso_de_imagem_aprovado": { "type": "boolean", "default": false, "description": "client approved using their logo/photos in videos" }
      }
    },
    "pedido": {
      "type": "object",
      "required": ["objetivo", "formato", "duracao_s", "voz", "cta"],
      "properties": {
        "objetivo": { "type": "string", "description": "e.g. gerar contatos no WhatsApp, divulgar serviço novo, institucional" },
        "publico": { "type": "string" },
        "formato": {
          "type": "object",
          "required": ["aspect"],
          "properties": {
            "aspect": { "enum": ["9:16", "1:1", "4:5", "16:9"] },
            "plataformas": { "type": "array", "items": { "enum": ["instagram-reels", "instagram-feed", "tiktok", "youtube-shorts", "youtube", "whatsapp-status", "site"] } }
          }
        },
        "duracao_s": { "type": "number", "minimum": 5, "maximum": 180 },
        "voz": {
          "type": "object",
          "required": ["usar"],
          "properties": {
            "usar": { "type": "boolean" },
            "provider": { "enum": ["gemini", "elevenlabs", "xai", "local", "file", "outro"], "description": "see voices/README.md" },
            "provider_outro": { "type": "string" },
            "tipo": { "type": "string", "description": "gender/age/energy/accent, e.g. 'masculina jovem, animada, pt-BR neutro'" },
            "voz_id": { "type": "string", "description": "provider voice name, e.g. Gemini 'Puck'" },
            "idioma": { "type": "string", "default": "pt-BR" }
          }
        },
        "musica": { "type": "string", "description": "mood/BPM or 'sem música'" },
        "legendas": { "type": "boolean", "default": true },
        "referencias": { "type": "array", "items": { "type": "string" }, "description": "links of videos/styles the client likes (structure only, never reuse their material)" },
        "cta": { "type": "string", "description": "one action, e.g. 'Chama no WhatsApp'" },
        "evitar": { "type": "array", "items": { "type": "string" }, "description": "things the client does not want (claims, colors, words)" },
        "material_proprio": { "type": "array", "items": { "type": "string" }, "description": "client footage/photos available for video-use/HyperFrames" }
      }
    },
    "pendencias": { "type": "array", "items": { "type": "string" }, "description": "questions still open; the brief can't be approved while a required item is here" }
  }
}
