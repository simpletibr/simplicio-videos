{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/simpletibr/simplicio-videos/schema/contract.schema.json",
  "title": "simplicio.video-contract/v1",
  "description": "Video contract: everything the simplicio-video CLI needs to render one video deterministically. The LLM reasons and writes this file; the CLI executes it. Scene-relative times (fala.inicio_s, sfx.t) are seconds from the scene start.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cliente", "campanha", "formato", "template", "cenas", "voz", "trilha", "saida"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "simplicio.video-contract/v1" },
    "cliente": {
      "type": "object", "additionalProperties": false, "required": ["slug", "nome", "drive_nome"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$", "description": "folder under clients/" },
        "nome": { "type": "string", "minLength": 1 },
        "drive_nome": { "$ref": "#/$defs/drive_token", "description": "Title_Case with underscores, no accents (e.g. Lothus_Odontologia)" },
        "coleta": { "type": "string", "description": "path (relative to the contract) of the client's coleta/ folder, source of every fact" }
      }
    },
    "campanha": {
      "type": "object", "additionalProperties": false, "required": ["id", "ano"],
      "properties": {
        "id": { "$ref": "#/$defs/drive_token", "description": "e.g. Dia_Criancas, Video_Institucional" },
        "ano": { "type": "integer", "minimum": 2020, "maximum": 2100 },
        "titulo": { "type": "string" },
        "objetivo": { "type": "string" }
      }
    },
    "formato": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "fps", "duracao_s"],
      "properties": {
        "aspect": { "enum": ["9:16", "1:1", "4:5", "16:9"] },
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "fps": { "type": "integer", "enum": [24, 25, 30, 50, 60] },
        "duracao_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 }
      }
    },
    "template": { "type": "string", "minLength": 1, "description": "templates/<id> in the repo, or a path (relative to the contract) to a template dir with template.json + composition/" },
    "marca": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "paleta": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "description": "named brand colors (informational + available to the template)" },
        "logo": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/asset" }], "description": "null = no logo file (text lockup); never recreate a logo" },
        "fontes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" }, "description": "extra client files copied into the composition (photos, logo variants)" },
    "variaveis": { "type": "object", "description": "raw HyperFrames variables merged after the scene textos (e.g. asset paths, colors the template declares)" },
    "placas_video": {
      "type": "array", "description": "optional full-bleed video plates (engine clips); missing file => black stand-in + <id>_on=false",
      "items": {
        "type": "object", "required": ["id", "file", "out", "start", "duration"],
        "properties": { "id": { "type": "string" }, "file": { "type": "string" }, "out": { "type": "string" }, "scene": { "type": "string" },
          "start": { "type": "number" }, "duration": { "type": "number" }, "media_start_s": { "type": "number" }, "shade": { "type": "number" }, "brief": { "type": "string" } }
      }
    },
    "cenas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "duracao_s"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
          "papel": { "type": "string", "description": "role from the template (gancho, promessa, marca, cta...)" },
          "duracao_s": { "type": "number", "exclusiveMinimum": 0 },
          "motion": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["padrao"],
              "properties": {
                "padrao": { "type": "string", "description": "motion/patterns/<id>" },
                "bloco": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$", "description": "instance id used by the template ({{vars:<bloco>}})" },
                "params": { "type": "object", "description": "block variables (see the pattern's pattern.json)" }
              }
            }
          },
          "textos": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] }, "description": "on-screen texts -> HyperFrames variables (key -> value)" },
          "tela": { "type": "array", "items": { "type": "string" }, "description": "on-screen copy as read by a human (documentation only)" },
          "fala": { "$ref": "#/$defs/fala" },
          "sfx": { "type": "array", "items": { "$ref": "#/$defs/sfx" } }
        }
      }
    },
    "voz": {
      "type": "object", "additionalProperties": false, "required": ["provider"],
      "properties": {
        "habilitada": { "type": "boolean", "default": true },
        "provider": { "enum": ["file", "local", "gemini", "voxcpm", "openvoice", "voicestudio", "elevenlabs", "xai"] },
        "voice": { "type": "string", "description": "voice name for the active provider (e.g. pf_dora for local/kokoro, Sulafat for gemini)" },
        "estilo": { "type": "string", "description": "delivery style instruction (Gemini speech_metadata style)" },
        "idioma": { "type": "string", "default": "pt-BR" },
        "processamento": { "type": "string", "description": "ffmpeg filter chain applied after silence trim" },
        "gain_db": { "type": "number" },
        "duck_music_db": { "type": "number" },
        "duck_sfx_db": { "type": "number" },
        "jcut_max_s": { "type": "number", "minimum": 0, "default": 0.15, "description": "how far a line may run past its scene end (J-cut)" },
        "cache_dir": { "type": "string", "default": "assets/audio/voz" },
        "providers": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "file": { "type": "object", "properties": { "dir": { "type": "string" }, "padroes": { "type": "array", "items": { "type": "string" } }, "origem": { "type": "string" } } },
            "local": { "type": "object", "properties": { "engine": { "enum": ["kokoro"] }, "voice": { "type": "string" }, "speed": { "type": "number" }, "lang": { "type": "string" } } },
            "gemini": { "type": "object", "properties": { "model": { "type": "string", "description": "gemini-3.8-flash-tts (default) or gemini-3.8-flash-lite-tts (cheaper, same schema)" }, "voice": { "type": "string" }, "alternativas": { "type": "array", "items": { "type": "string" } }, "estilo": { "type": "string" }, "api": { "enum": ["interactions", "generate_content"], "default": "interactions", "description": "Gemini Interactions API (default) or generateContent with responseModalities AUDIO" } } },
            "voxcpm": { "type": "object", "additionalProperties": false, "properties": { "control": { "type": "string", "description": "voice-design / style description, e.g. 'Young female voice, warm and gentle'" }, "reference_audio": { "type": "string", "description": "clean clip of an authorized speaker (relative to the contract); enables cloning" }, "reference_text": { "type": "string", "description": "exact transcript of reference_audio (ultimate cloning)" }, "seed": { "type": "integer", "default": 42 } } },
            "openvoice": { "type": "object", "additionalProperties": false, "properties": { "reference_audio": { "type": "string", "description": "clean 10-30 s clip of an authorized speaker (relative to the contract)" } } },
            "voicestudio": { "type": "object", "additionalProperties": false, "properties": { "model": { "type": "string", "default": "omnivoice" }, "voice": { "type": "string", "description": "voice-profile id from GET /v1/audio/voices" } } },
            "elevenlabs": { "type": "object" },
            "xai": { "type": "object" }
          }
        }
      }
    },
    "trilha": {
      "type": "object", "additionalProperties": false, "required": ["bpm", "seed", "music", "master"],
      "properties": {
        "bpm": { "type": "number", "minimum": 40, "maximum": 220 },
        "seed": { "type": "integer" },
        "music": { "type": "object", "required": ["gain_db", "fade_in_s", "fade_out_s", "progression"], "description": "engine arrangement (build.mjs): style, progression, sections, melody..." },
        "master": { "type": "object", "additionalProperties": false, "required": ["target_lufs", "true_peak_db"],
          "properties": { "target_lufs": { "type": "number", "maximum": -8, "minimum": -30 }, "true_peak_db": { "type": "number", "maximum": 0 } } }
      }
    },
    "saida": {
      "type": "object", "additionalProperties": false, "required": ["arquivo"],
      "properties": {
        "arquivo": { "type": "string", "pattern": "\\.mp4$", "description": "output path relative to the contract (gitignored out/)" },
        "qualidade": { "enum": ["draft", "looks", "delivery"], "default": "delivery" },
        "preview": { "type": "string", "description": "optional 720p preview path relative to the contract" }
      }
    }
  },
  "$defs": {
    "drive_token": { "type": "string", "pattern": "^[A-Z0-9][A-Za-z0-9]*(_[A-Za-z0-9]+)*$" },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["arquivo", "destino"],
      "properties": {
        "arquivo": { "type": "string", "description": "source path relative to the contract" },
        "destino": { "type": "string", "pattern": "^assets/", "description": "path inside the composition" }
      }
    },
    "fala": {
      "type": "object", "additionalProperties": false, "required": ["id", "texto", "inicio_s", "max_s"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,16}$" },
        "texto": { "type": "string", "minLength": 1, "description": "exact copy (facts from coleta/)" },
        "say": { "type": "string", "description": "pronunciation respelling sent to TTS" },
        "inicio_s": { "type": "number", "minimum": 0, "description": "start, seconds from scene start" },
        "max_s": { "type": "number", "exclusiveMinimum": 0, "description": "slot length; longer take = error (never speed up)" },
        "marcas": { "type": "array", "items": { "type": "object", "required": ["palavra", "t"], "properties": { "palavra": { "type": "string" }, "t": { "type": "number", "minimum": 0 } } }, "description": "optional word marks (seconds from line start)" }
      }
    },
    "sfx": {
      "type": "object", "additionalProperties": false, "required": ["id", "t", "tipo"],
      "properties": {
        "id": { "type": "string" },
        "t": { "type": "number", "minimum": 0, "description": "seconds from scene start" },
        "tipo": { "enum": ["hit", "impact", "whoosh", "click", "blip", "riser", "glitch", "shimmer", "pop", "boing", "chime", "slide", "tambourine", "woodblock"] },
        "args": { "type": "array" },
        "gain_db": { "type": "number" },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "duck_db": { "type": "number" }
      }
    }
  }
}
